# Copia este archivo a .env.local (local) o cárgalo en Netlify > Site settings > Environment variables.

# URL pública del sitio (canonical, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://neural-factory.com

# Formulario de contacto (Resend). El remitente debe pertenecer a un dominio verificado en Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Neural Factory <contacto@neural-factory.com>"
# Destino de los mensajes. Si se omite, se usa info@neural-factory.com
CONTACT_TO_EMAIL=

# Opcional: código de verificación de Google Search Console (solo el valor de content="...")
NEXT_PUBLIC_GSC_VERIFICATION=

# Opcional: forzar noindex (por ejemplo en un preview). Netlify ya marca noindex fuera de producción.
# NEXT_PUBLIC_NOINDEX=true
